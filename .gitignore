node_modules/
.DS_Store

# Style Dictionary intermediates (dist/ artifacts themselves ARE committed)
dist/.sd/

# Prebuilt Tailwind utilities — build artifact (npm run build:tw); not committed
dist/utilities.css

# Mitosis framework output — build artifact (npm run build:components)
# (lives under packages/components/dist since the workspace split)
**/dist/frameworks/
# Compiled, publishable framework packages (derived from dist/frameworks via build:pkg)
**/dist/pkg/
# Temp modules from the cross-framework render harness (build/render-fw.mjs)
.fwtmp-*/

# Astro / Starlight build output & cache (site output goes to site-dist/)
site-dist/
.astro/

# Playwright — reports/results are generated; snapshot BASELINES are committed
test-results/
playwright-report/
blob-report/
.playwright/

# Generated Starlight content — built from the reference Markdown by
# `npm run build:content`. index.mdx is authored and IS committed.
src/content/docs/guide/
src/content/docs/reference/
src/content/docs/build/

# Provider skill installs — generated by `npm run skills:sync` from the root skill
.claude/skills/
.cursor/skills/
.opencode/skills/

# Secrets — never commit tokens (Figma PAT etc.).
# NOTE: kept specific so it never matches the design-token JSON (*.tokens.json).
.env
.env.*
!.env.example
*.pat
*.secret
figma-token*
*.token.txt

# scratch screenshots (root only; tests/*-snapshots baselines stay tracked)
/scratch-*.png
/s-*.png
/refresh-*.png
/board-*.png
/scratch-shot.mjs
/*.png
.mitosis-cache/
