      }
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "com.doxee.cssVar": "--space-3"
      }
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "com.doxee.cssVar": "--space-4"
      }
    },
    "space-5": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
