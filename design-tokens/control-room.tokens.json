  "typography": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "\"CR Sans\", \"Archivo\", \"Arial Black\", \"Helvetica Neue\", system-ui, sans-serif",
      "$extensions": {
        "com.doxee.cssVar": "--font-sans"
      }
    },
    "font-display": {
      "$value": "\"CR Display\", \"Saira Condensed\", \"Archivo Narrow\", \"Oswald\", var(--font-sans)",
      "$extensions": {
        "com.doxee.cssVar": "--font-display"
      }
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "\"CR Mono\", \"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "$extensions": {
        "com.doxee.cssVar": "--font-mono"
      }
    },
    "type-display-weight": {
      "$type": "fontWeight",
      "$value": 900,
      "$extensions": {
        "com.doxee.cssVar": "--type-display-weight"
      }
    },
    "type-display-tracking": {
      "$type": "dimension",
      "$value": "-0.038em",
      "$extensions": {
        "com.doxee.cssVar": "--type-display-tracking"
      }
    },
    "type-display-leading": {
      "$type": "number",
      "$value": 0.9,
      "$extensions": {
        "com.doxee.cssVar": "--type-display-leading"
      }
    },
    "type-display-transform": {
      "$value": "uppercase",
      "$extensions": {
        "com.doxee.cssVar": "--type-display-transform"
      }
    },
    "type-data-size": {
      "$type": "dimension",
      "$value": "13px",
      "$extensions": {
        "com.doxee.cssVar": "--type-data-size"
      }
    },
    "type-data-size-sm": {
      "$type": "dimension",
      "$value": "11px",
      "$description": "labels, chrome",
      "$extensions": {
        "com.doxee.cssVar": "--type-data-size-sm"
      }
    },
    "type-label-tracking": {
      "$type": "dimension",
      "$value": "0.07em",
      "$extensions": {
        "com.doxee.cssVar": "--type-label-tracking"
      }
    },
    "type-label-transform": {
      "$value": "uppercase",
      "$extensions": {
        "com.doxee.cssVar": "--type-label-transform"
      }
    }
  },
  "motion": {
    "dur-press": {
      "$type": "duration",
      "$value": "120ms",
      "$extensions": {
        "com.doxee.cssVar": "--dur-press"
      }
    },
    "dur-fast": {
      "$type": "duration",
      "$value": "160ms",
      "$description": "hover / interaction transitions",
      "$extensions": {
        "com.doxee.cssVar": "--dur-fast"
      }
    },
    "dur-med": {
      "$type": "duration",
      "$value": "260ms",
      "$description": "reveals, keyed moves",
      "$extensions": {
        "com.doxee.cssVar": "--dur-med"
      }
    },
    "dur-ambient": {
      "$type": "duration",
      "$value": "3200ms",
      "$description": "idle attention / filler loops",
      "$extensions": {
        "com.doxee.cssVar": "--dur-ambient"
      }
    },
    "ease-snap": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)",
      "$description": "hard, decisive — the house feel (no soft overshoot/bounce)",
      "$extensions": {
        "com.doxee.cssVar": "--ease-snap"
      }
    },
    "ease-step": {
      "$value": "steps(3, jump-none)",
      "$description": "stepped / digital motion (glitch, tickers)",
      "$extensions": {
        "com.doxee.cssVar": "--ease-step"
      }
    },
    "tick-ambient": {
      "$type": "duration",
      "$value": "180ms",
      "$extensions": {
        "com.doxee.cssVar": "--tick-ambient"
      }
    }
  },
  "component": {
    "cr-btn-pad-x": {
      "$value": "var(--space-4)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-btn-pad-x"
