      }
    },
    "space-8": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "com.doxee.cssVar": "--space-8"
      }
    },
    "space-10": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": {
        "com.doxee.cssVar": "--space-10"
      }
    },
    "space-12": {
      "$type": "dimension",
      "$value": "48px",
      "$extensions": {
        "com.doxee.cssVar": "--space-12"
      }
    },
    "space-16": {
      "$type": "dimension",
      "$value": "64px",
      "$extensions": {
        "com.doxee.cssVar": "--space-16"
      }
    },
    "space-px": {
      "$type": "dimension",
      "$value": "1px",
      "$extensions": {
