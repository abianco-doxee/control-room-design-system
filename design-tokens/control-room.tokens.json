      "$extensions": {
        "com.doxee.cssVar": "--cr-btn-pad-y"
      }
    },
    "cr-btn-gap": {
      "$value": "var(--space-2)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-btn-gap"
      }
    },
    "cr-btn-bg": {
      "$value": "var(--sig-wait)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-btn-bg"
      }
    },
    "cr-btn-fg": {
      "$value": "var(--on-sig)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-btn-fg"
      }
