    "cr-chip-fg": {
      "$value": "var(--on-sig)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-chip-fg"
      }
    },
    "cr-row-pad-y": {
      "$value": "var(--space-2)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-row-pad-y"
      }
    },
    "cr-row-gap": {
      "$value": "var(--space-3)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-row-gap"
      }
    },
    "cr-hero-pad": {
      "$value": "var(--space-4)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-hero-pad"
      }
    },
    "cr-hero-gap": {
      "$value": "var(--space-4)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-hero-gap"
      }
    },
    "cr-hero-bg": {
      "$value": "var(--sig-accent)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-hero-bg"
      }
    },
    "cr-hero-fg": {
      "$value": "var(--on-accent)",
      "$extensions": {
        "com.doxee.cssVar": "--cr-hero-fg"
      }
    },
    "cr-nav-w": {
      "$type": "dimension",
      "$value": "180px",
      "$extensions": {
        "com.doxee.cssVar": "--cr-nav-w"
      }
    }
