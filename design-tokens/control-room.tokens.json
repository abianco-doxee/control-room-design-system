        },
        "board": {
          "$type": "color",
          "$value": "#15092f",
          "$description": "instrument / work surface",
          "$extensions": {
            "com.doxee.cssVar": "--board"
          }
        },
        "panel": {
          "$type": "color",
          "$value": "#1d133a",
          "$description": "raised card / panel",
          "$extensions": {
            "com.doxee.cssVar": "--panel"
          }
        },
        "panel-2": {
          "$type": "color",
          "$value": "#271d45",
          "$description": "recessed / inset region",
          "$extensions": {
            "com.doxee.cssVar": "--panel-2"
          }
        },
        "rail": {
