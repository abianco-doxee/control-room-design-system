{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "$description": "Control Room design tokens — framework-agnostic (DTCG). Generated from tokens/tokens.json; do not edit by hand.",
  "chassis": {
    "brd": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "internal dividers, minor panels",
      "$extensions": {
        "com.doxee.cssVar": "--brd"
      }
    },
    "brd-heavy": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "major panels, mastheads, primary buttons",
      "$extensions": {
        "com.doxee.cssVar": "--brd-heavy"
      }
    },
    "brd-brush": {
      "$type": "dimension",
      "$value": "5px",
      "$description": "outer chassis, bezels",
      "$extensions": {
        "com.doxee.cssVar": "--brd-brush"
      }
    },
    "shadow-off": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "standard hard drop offset",
      "$extensions": {
        "com.doxee.cssVar": "--shadow-off"
      }
    },
    "shadow-off-lg": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "mastheads, live instruments",
      "$extensions": {
        "com.doxee.cssVar": "--shadow-off-lg"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "0px",
      "$extensions": {
        "com.doxee.cssVar": "--radius"
      }
    },
    "halftone-size": {
      "$type": "dimension",
      "$value": "7px",
      "$extensions": {
        "com.doxee.cssVar": "--halftone-size"
      }
    }
  },
  "typography": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "\"CR Sans\", \"Archivo\", \"Arial Black\", \"Helvetica Neue\", system-ui, sans-serif",
      "$extensions": {
        "com.doxee.cssVar": "--font-sans"
      }
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "\"CR Mono\", \"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "$extensions": {
        "com.doxee.cssVar": "--font-mono"
      }
    },
    "type-display-weight": {
      "$type": "fontWeight",
      "$value": 900,
      "$extensions": {
        "com.doxee.cssVar": "--type-display-weight"
      }
    },
    "type-display-tracking": {
      "$type": "dimension",
      "$value": "-0.038em",
      "$extensions": {
        "com.doxee.cssVar": "--type-display-tracking"
      }
    },
    "type-display-leading": {
      "$type": "number",
      "$value": 0.9,
      "$extensions": {
        "com.doxee.cssVar": "--type-display-leading"
      }
    },
    "type-display-transform": {
      "$value": "uppercase",
      "$extensions": {
        "com.doxee.cssVar": "--type-display-transform"
      }
    },
    "type-data-size": {
      "$type": "dimension",
      "$value": "13px",
      "$extensions": {
        "com.doxee.cssVar": "--type-data-size"
      }
    },
    "type-data-size-sm": {
      "$type": "dimension",
      "$value": "11px",
      "$description": "labels, chrome",
      "$extensions": {
        "com.doxee.cssVar": "--type-data-size-sm"
      }
    },
    "type-label-tracking": {
      "$type": "dimension",
      "$value": "0.07em",
      "$extensions": {
        "com.doxee.cssVar": "--type-label-tracking"
      }
    },
    "type-label-transform": {
      "$value": "uppercase",
      "$extensions": {
        "com.doxee.cssVar": "--type-label-transform"
      }
