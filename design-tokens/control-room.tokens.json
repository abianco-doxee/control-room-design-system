    "space-0-5": {
      "$type": "dimension",
      "$value": "2px",
      "$extensions": {
        "com.doxee.cssVar": "--space-0-5"
      }
    },
    "text-2xs": {
      "$type": "dimension",
      "$value": "10px",
      "$extensions": {
        "com.doxee.cssVar": "--text-2xs"
      }
    },
    "text-xs": {
      "$type": "dimension",
      "$value": "11px",
      "$extensions": {
        "com.doxee.cssVar": "--text-xs"
      }
    },
    "text-sm": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "com.doxee.cssVar": "--text-sm"
      }
    },
    "text-base": {
      "$type": "dimension",
      "$value": "13px",
      "$extensions": {
        "com.doxee.cssVar": "--text-base"
      }
    },
    "text-md": {
      "$type": "dimension",
      "$value": "15px",
      "$extensions": {
        "com.doxee.cssVar": "--text-md"
      }
    },
    "text-lg": {
      "$type": "dimension",
      "$value": "19px",
      "$extensions": {
        "com.doxee.cssVar": "--text-lg"
      }
    },
    "text-xl": {
      "$value": "clamp(28px, 5.5vw, 52px)",
      "$description": "display / single big number",
      "$extensions": {
        "com.doxee.cssVar": "--text-xl"
      }
    },
    "leading-tight": {
      "$value": "1.05",
      "$extensions": {
        "com.doxee.cssVar": "--leading-tight"
      }
    },
    "leading-normal": {
      "$value": "1.6",
      "$extensions": {
        "com.doxee.cssVar": "--leading-normal"
      }
    },
    "leading-display": {
      "$value": "0.9",
      "$extensions": {
        "com.doxee.cssVar": "--leading-display"
      }
    },
    "radius-none": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "always 0 — system law",
      "$extensions": {
        "com.doxee.cssVar": "--radius-none"
      }
    },
    "z-base": {
      "$value": "0",
      "$extensions": {
        "com.doxee.cssVar": "--z-base"
      }
    },
    "z-raised": {
      "$value": "10",
      "$extensions": {
        "com.doxee.cssVar": "--z-raised"
      }
    },
    "z-sticky": {
      "$value": "50",
      "$extensions": {
        "com.doxee.cssVar": "--z-sticky"
      }
    },
    "z-overlay": {
      "$value": "100",
      "$extensions": {
        "com.doxee.cssVar": "--z-overlay"
      }
    },
    "z-modal": {
      "$value": "1000",
      "$extensions": {
        "com.doxee.cssVar": "--z-modal"
      }
    }
