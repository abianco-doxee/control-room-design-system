  "chassis": {
    "brd-hair": {
      "$type": "dimension",
      "$value": "1.5px",
      "$description": "hairline — dot/tag outlines, row separators, dense chrome (thinner than --brd)",
      "$extensions": {
        "com.doxee.cssVar": "--brd-hair"
      }
    },
    "brd": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "internal dividers, minor panels",
      "$extensions": {
        "com.doxee.cssVar": "--brd"
      }
    },
    "brd-heavy": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "major panels, mastheads, primary buttons",
      "$extensions": {
        "com.doxee.cssVar": "--brd-heavy"
      }
    },
    "brd-brush": {
      "$type": "dimension",
      "$value": "5px",
      "$description": "outer chassis, bezels",
      "$extensions": {
        "com.doxee.cssVar": "--brd-brush"
      }
    },
    "shadow-off-sm": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "small floating pieces — menus, chips, popovers",
      "$extensions": {
        "com.doxee.cssVar": "--shadow-off-sm"
      }
    },
    "shadow-off": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "standard hard drop offset",
      "$extensions": {
        "com.doxee.cssVar": "--shadow-off"
      }
    },
    "shadow-off-lg": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "mastheads, live instruments",
      "$extensions": {
        "com.doxee.cssVar": "--shadow-off-lg"
      }
    },
    "state-disabled-op": {
      "$value": "0.45",
      "$description": "opacity for a disabled control",
      "$extensions": {
        "com.doxee.cssVar": "--state-disabled-op"
      }
    },
    "state-hover-mix": {
      "$value": "12%",
      "$description": "amount of --ink mixed into a surface on hover (color-mix)",
      "$extensions": {
        "com.doxee.cssVar": "--state-hover-mix"
      }
    },
    "row-h": {
      "$type": "dimension",
      "$value": "34px",
      "$description": "default dense-table row height (density baseline)",
      "$extensions": {
        "com.doxee.cssVar": "--row-h"
      }
    },
    "focus-w": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "keyboard focus-ring thickness (colour is --sig-work, themed)",
      "$extensions": {
        "com.doxee.cssVar": "--focus-w"
      }
    },
    "focus-offset": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "keyboard focus-ring offset from the control edge",
      "$extensions": {
        "com.doxee.cssVar": "--focus-offset"
      }
    },
    "motion-intensity": {
      "$value": "1",
      "$description": "loudness dial (0..1) for non-essential animation; the `calm` ops profile sets 0",
      "$extensions": {
        "com.doxee.cssVar": "--motion-intensity"
      }
    },
    "decoration-intensity": {
      "$value": "1",
      "$description": "loudness dial (0..1) for decorative texture layers; the `calm` ops profile tones it down",
      "$extensions": {
        "com.doxee.cssVar": "--decoration-intensity"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "0px",
      "$extensions": {
        "com.doxee.cssVar": "--radius"
      }
    },
    "halftone-size": {
      "$type": "dimension",
      "$value": "7px",
      "$extensions": {
        "com.doxee.cssVar": "--halftone-size"
      }
    },
    "breach-radius": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "the one soft corner",
      "$extensions": {
        "com.doxee.cssVar": "--breach-radius"
      }
    },
    "breach-blur": {
      "$type": "dimension",
      "$value": "26px",
      "$description": "blurred-blob softness",
      "$extensions": {
        "com.doxee.cssVar": "--breach-blur"
      }
    },
    "breach-glow-size": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "soft glow radius",
      "$extensions": {
        "com.doxee.cssVar": "--breach-glow-size"
      }
    }
