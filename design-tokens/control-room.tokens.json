          "$value": "#06050c",
          "$description": "text on the second accent",
          "$extensions": {
            "com.doxee.cssVar": "--on-accent-2"
          }
        },
        "on-idle": {
          "$type": "color",
          "$value": "#06050c",
          "$description": "text/icon on an idle (--sig-idle) fill",
