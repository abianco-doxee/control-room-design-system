{
  "name": "control-room-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A real Qwik City dashboard built on Control Room — consumes the tokens, the cr- classes, and the Mitosis-compiled Qwik components.",
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build --ssr src/entry.ssr.tsx",
    "preview": "qwik build preview && vite preview --open"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "arktype": "^2.2.3",
    "cronstrue": "^3.24.0"
  }
}
