{
  "name": "@control-room/styles",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Control Room component styles — the authored all-in-one bundle (components.css), the thin global/base layer (base.css) and the per-component partials (parts/*.css) for PrimeVue-style import-on-use, plus the Tailwind v4 entry. Pairs with @control-room/tokens.",
  "keywords": [
    "control-room",
    "design-system",
    "css",
    "styles",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alebianco/control-room-design-system.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/alebianco/control-room-design-system#readme",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "styles",
    "dist"
  ],
  "exports": {
    "./components": "./styles/components.css",
    "./base": "./styles/base.css",
    "./parts/*": "./styles/parts/*",
    "./tailwind.css": "./styles/tailwind.css",
    "./utilities.css": "./dist/utilities.css"
  },
  "scripts": {
    "build": "node build/build-styles.mjs",
    "build:utilities": "tailwindcss -i tailwind-input.css -o dist/utilities.css",
    "verify": "node build/build-styles.mjs --check"
  },
  "dependencies": {
    "@control-room/tokens": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
