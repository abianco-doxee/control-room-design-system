{
  "name": "@alebianco/cr-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control Room documentation site (Astro + Starlight) \u2014 the dev-only leaf. Builds the reference docs, the live gallery, the component browser (React islands from @alebianco/cr-components), and the brand preview from the sibling packages; plus the Playwright a11y / islands / responsive / visual suites.",
  "scripts": {
    "build:content": "node build/build-docs-content.mjs",
    "build:showcase": "node build/build-showcase.mjs",
    "build:brand-preview": "node build/build-brand-preview.mjs",
    "verify:brand-preview": "node build/build-brand-preview.mjs --check",
    "build:llms": "node build/build-llms.mjs",
    "verify:llms": "node build/build-llms.mjs --check",
    "prebuild:site": "npm run build:content",
    "build:site": "astro build",
    "dev": "npm run build:content && astro dev",
    "preview": "astro preview",
    "test:a11y": "playwright test tests/a11y-showcase.spec.mjs",
    "test:islands": "playwright test tests/showcase-islands.spec.mjs",
    "test:responsive": "playwright test tests/responsive.spec.mjs",
    "test:visual": "playwright test tests/visual.spec.mjs",
    "test:visual:update": "playwright test tests/visual.spec.mjs --update-snapshots",
    "test:e2e": "playwright test",
    "test:client": "playwright test tests/client-runtime.spec.mjs"
  },
  "dependencies": {
    "@alebianco/cr-components": "workspace:*",
    "@alebianco/cr-icons": "workspace:*",
    "@alebianco/cr-styles": "workspace:*",
    "@alebianco/cr-tokens": "workspace:*",
    "@alebianco/cr-utils": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "astro": "^7.2.2",
    "esbuild": "^0.28.2"
  }
}
