{
  "$schema": "https://schemas.control-room.dev/design-tokens/v1",
  "$description": "Control Room design tokens. Machine-readable source of truth for the token layer. Generated artifacts (dist/, design-tokens/) are built from this via npm run build:tokens.",
  "meta": {
    "name": "Control Room",
    "version": "1.0.0",
    "defaultTheme": "dark",
    "themes": [
      "dark",
      "light",
      "extreme",
      "phosphor"
    ],
    "selector": "html[data-theme]"
  },
  "primitive": {
    "$comment": "Global/primitive tier \u2014 context-free scales. Semantic + component tokens reference these; component CSS MUST use these, never raw px. Spacing is a 4px base (step n = 4n), matching Tailwind.",
    "space": {
      "0": {
        "value": "0",
        "cssVar": "--space-0"
      },
      "px": {
        "value": "1px",
        "cssVar": "--space-px"
      },
      "0-5": {
        "value": "2px",
        "cssVar": "--space-0-5"
      },
      "1": {
        "value": "4px",
        "cssVar": "--space-1"
      },
      "2": {
        "value": "8px",
        "cssVar": "--space-2"
      },
      "3": {
        "value": "12px",
        "cssVar": "--space-3"
      },
      "4": {
        "value": "16px",
        "cssVar": "--space-4"
      },
      "5": {
        "value": "20px",
        "cssVar": "--space-5"
      },
      "6": {
        "value": "24px",
        "cssVar": "--space-6"
      },
      "8": {
        "value": "32px",
        "cssVar": "--space-8"
      },
      "10": {
        "value": "40px",
        "cssVar": "--space-10"
      },
      "12": {
        "value": "48px",
        "cssVar": "--space-12"
      },
      "16": {
        "value": "64px",
        "cssVar": "--space-16"
      }
    },
    "text": {
      "2xs": {
        "value": "10px",
        "cssVar": "--text-2xs"
      },
      "xs": {
        "value": "11px",
        "cssVar": "--text-xs"
      },
      "sm": {
        "value": "12px",
        "cssVar": "--text-sm"
      },
      "base": {
        "value": "13px",
        "cssVar": "--text-base"
      },
      "md": {
        "value": "15px",
        "cssVar": "--text-md"
      },
      "lg": {
        "value": "19px",
        "cssVar": "--text-lg"
      },
      "xl": {
        "value": "clamp(28px, 5.5vw, 52px)",
        "cssVar": "--text-xl",
        "use": "display / single big number"
      }
    },
    "leading": {
      "tight": {
        "value": "1.05",
        "cssVar": "--leading-tight"
      },
      "normal": {
        "value": "1.6",
        "cssVar": "--leading-normal"
      },
      "display": {
        "value": "0.9",
        "cssVar": "--leading-display"
      }
    },
    "radius": {
      "none": {
        "value": "0px",
        "cssVar": "--radius-none",
        "use": "always 0 \u2014 system law"
      }
    },
    "z": {
      "base": {
        "value": "0",
        "cssVar": "--z-base"
      },
      "raised": {
        "value": "10",
        "cssVar": "--z-raised"
      },
      "sticky": {
        "value": "50",
        "cssVar": "--z-sticky"
      },
      "overlay": {
        "value": "100",
        "cssVar": "--z-overlay"
      },
      "modal": {
        "value": "1000",
        "cssVar": "--z-modal"
      }
    }
  },
  "chassis": {
    "$comment": "Theme-independent structural tokens. Overridden ONLY by the extreme theme.",
    "border": {
      "thin": {
        "value": "2px",
        "cssVar": "--brd",
        "use": "internal dividers, minor panels"
      },
      "heavy": {
        "value": "3px",
        "cssVar": "--brd-heavy",
        "use": "major panels, mastheads, primary buttons"
      },
      "brush": {
        "value": "5px",
        "cssVar": "--brd-brush",
        "use": "outer chassis, bezels"
      }
    },
    "shadow": {
      "offset": {
        "value": "4px",
        "cssVar": "--shadow-off",
        "use": "standard hard drop offset"
      },
      "offsetLg": {
        "value": "6px",
        "cssVar": "--shadow-off-lg",
        "use": "mastheads, live instruments"
      },
      "$rule": "Hard offset only. blur-radius and spread are always 0. There is no soft shadow token."
    },
    "radius": {
      "value": "0px",
      "cssVar": "--radius",
      "$rule": "Always 0. This token exists so the 0 is explicit and greppable."
    },
    "halftoneSize": {
      "value": "7px",
      "cssVar": "--halftone-size"
    }
  },
  "typography": {
    "$comment": "Two registers only \u2014 display and data. Nothing between (Law 5).",
    "family": {
      "sans": {
        "value": "\"CR Sans\", \"Archivo\", \"Arial Black\", \"Helvetica Neue\", system-ui, sans-serif",
        "cssVar": "--font-sans"
      },
      "mono": {
        "value": "\"CR Mono\", \"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
        "cssVar": "--font-mono"
      }
    },
    "display": {
      "weight": {
        "value": 900,
        "cssVar": "--type-display-weight"
      },
      "tracking": {
        "value": "-0.038em",
        "cssVar": "--type-display-tracking"
      },
      "leading": {
        "value": 0.9,
        "cssVar": "--type-display-leading",
        "range": "0.88\u20130.92"
      },
      "transform": {
        "value": "uppercase",
        "cssVar": "--type-display-transform"
      },
      "sizeFluid": {
        "value": "clamp(28px, 5.5vw, 52px)",
        "use": "masthead / single big number"
      }
    },
    "data": {
      "size": {
        "value": "13px",
        "cssVar": "--type-data-size",
        "range": "12\u201313px"
      },
      "sizeSm": {
        "value": "11px",
        "cssVar": "--type-data-size-sm",
        "use": "labels, chrome"
      },
      "labelTracking": {
        "value": "0.07em",
        "cssVar": "--type-label-tracking"
      },
      "labelTransform": {
        "value": "uppercase",
        "cssVar": "--type-label-transform"
      }
    },
    "$forbidden": "No sans body text at 18\u201324px. That mid-register makes tools read as generic admin templates."
  },
  "motion": {
    "durPress": {
      "value": "120ms",
      "cssVar": "--dur-press",
      "tier": 0
    },
    "tickAmbient": {
      "value": "180ms",
      "cssVar": "--tick-ambient",
      "tier": 1,
      "fps": "~5.5"
    }
  },
  "semantic": {
    "$comment": "Every semantic role maps to one cssVar. The value differs per theme; the meaning never does.",
    "surface": {
      "ground": {
        "cssVar": "--ground",
        "role": "page background, furthest back"
      },
      "board": {
        "cssVar": "--board",
        "role": "instrument / work surface"
      },
      "panel": {
        "cssVar": "--panel",
        "role": "raised card / panel"
      },
      "panel2": {
        "cssVar": "--panel-2",
        "role": "recessed / inset region"
      },
      "rail": {
        "cssVar": "--rail",
        "role": "navigation rail background"
      }
    },
    "text": {
      "ink": {
        "cssVar": "--ink",
        "role": "primary text"
      },
      "muted": {
        "cssVar": "--muted",
        "role": "secondary / label text"
      },
      "railInk": {
        "cssVar": "--rail-ink",
        "role": "text on the rail"
      },
      "onSig": {
        "cssVar": "--on-sig",
        "role": "text/icon placed on a signal fill"
      },
      "onErr": {
        "cssVar": "--on-err",
        "role": "text/icon on an error (--sig-err) fill; white in light, dark elsewhere"
      },
      "onAccent": {
        "cssVar": "--on-accent",
        "role": "text/icon on an accent (--sig-accent) fill"
      },
      "onIdle": {
        "cssVar": "--on-idle",
        "role": "text/icon on an idle (--sig-idle) fill"
      }
    },
    "line": {
      "border": {
        "cssVar": "--border",
        "role": "contour / outline (near-black)"
      },
      "mass": {
        "cssVar": "--mass",
        "role": "black as a large fill area (Law 1)"
      },
      "shadowCol": {
        "cssVar": "--shadow-col",
        "role": "hard offset shadow color"
      }
    },
    "signal": {
      "$comment": "The state ramp. Each hue is bound to a machine state (Law 2). Color IS the state channel.",
      "work": {
        "cssVar": "--sig-work",
        "state": "working",
        "note": "also the default focus outline"
      },
      "wait": {
        "cssVar": "--sig-wait",
        "state": "waiting / needs input"
      },
      "done": {
        "cssVar": "--sig-done",
        "state": "done / merged"
      },
      "err": {
        "cssVar": "--sig-err",
        "state": "error / failing"
      },
      "idle": {
        "cssVar": "--sig-idle",
        "state": "idle"
      },
      "accent": {
        "cssVar": "--sig-accent",
        "state": "attention / primary action"
      }
    },
    "keyed": {
      "stage": {
        "cssVar": "--stage",
        "role": "calm/nominal keyed stage flood (Law 2)"
      },
      "stageInk": {
        "cssVar": "--stage-ink",
        "role": "text on the stage flood"
      },
      "drip": {
        "cssVar": "--drip",
        "role": "house glitch / decay hue (Law 3)"
      }
    },
    "texture": {
      "halftone": {
        "cssVar": "--halftone",
        "role": "hardware texture; legal inside a bezel only (Law 6)"
      }
    }
  },
  "component": {
    "$comment": "Component tier \u2014 per-component tokens referencing semantic/primitive. Override these to restyle a component without touching its CSS. Theme-independent (values are var() refs that resolve per theme).",
    "button": {
      "padX": {
        "value": "var(--space-4)",
        "cssVar": "--cr-btn-pad-x"
      },
      "padY": {
        "value": "var(--space-2)",
        "cssVar": "--cr-btn-pad-y"
      },
      "gap": {
        "value": "var(--space-2)",
        "cssVar": "--cr-btn-gap"
      },
      "bg": {
        "value": "var(--sig-wait)",
        "cssVar": "--cr-btn-bg"
      },
      "fg": {
        "value": "var(--on-sig)",
        "cssVar": "--cr-btn-fg"
      },
      "size": {
        "value": "var(--text-sm)",
        "cssVar": "--cr-btn-size"
      }
    },
    "panel": {
      "pad": {
        "value": "var(--space-3)",
        "cssVar": "--cr-panel-pad"
      },
      "bg": {
        "value": "var(--panel)",
        "cssVar": "--cr-panel-bg"
      },
      "gap": {
        "value": "var(--space-3)",
        "cssVar": "--cr-panel-gap"
      }
    },
    "chip": {
      "padX": {
        "value": "var(--space-2)",
        "cssVar": "--cr-chip-pad-x"
      },
      "padY": {
        "value": "var(--space-0-5)",
        "cssVar": "--cr-chip-pad-y"
      },
      "bg": {
        "value": "var(--sig-done)",
        "cssVar": "--cr-chip-bg"
      },
      "fg": {
        "value": "var(--on-sig)",
        "cssVar": "--cr-chip-fg"
      }
    },
    "row": {
      "padY": {
        "value": "var(--space-2)",
        "cssVar": "--cr-row-pad-y"
      },
      "gap": {
        "value": "var(--space-3)",
        "cssVar": "--cr-row-gap"
      }
    },
    "hero": {
      "pad": {
        "value": "var(--space-4)",
        "cssVar": "--cr-hero-pad"
      },
      "gap": {
        "value": "var(--space-4)",
        "cssVar": "--cr-hero-gap"
      },
      "bg": {
        "value": "var(--sig-accent)",
        "cssVar": "--cr-hero-bg"
      },
      "fg": {
        "value": "var(--on-accent)",
        "cssVar": "--cr-hero-fg"
      }
    },
    "nav": {
      "width": {
        "value": "180px",
        "cssVar": "--cr-nav-w"
      }
    }
  },
  "themes": {
    "dark": {
      "$label": "Dark \u00b7 default \u00b7 Edgerunners ramp",
      "ground": "#0a0a12",
      "board": "#0e0e18",
      "panel": "#14141f",
      "panel-2": "#191926",
      "ink": "#e6e6f2",
      "muted": "#8a8aa6",
      "border": "#000000",
      "rail": "#050509",
      "rail-ink": "#c8c8de",
      "sig-work": "#22d3ee",
      "sig-accent": "#ff2e97",
      "sig-done": "#5eead4",
      "sig-wait": "#fde047",
      "sig-err": "#ff3b6b",
      "sig-idle": "#6b6b8a",
      "on-sig": "#050509",
      "on-err": "#050509",
      "on-accent": "#050509",
      "on-idle": "#ffffff",
      "shadow-col": "#000000",
      "mass": "#000000",
      "stage": "#00b34a",
      "stage-ink": "#04140a",
      "drip": "#4affc8",
      "halftone": "radial-gradient(circle at center, rgba(255,255,255,.05) 1.1px, transparent 1.4px)"
    },
    "light": {
      "$label": "Light \u00b7 ink-on-paper \u00b7 newsprint",
      "ground": "#ecebe3",
      "board": "#e4e3d9",
      "panel": "#ffffff",
      "panel-2": "#f6f5ef",
      "ink": "#0b0b12",
      "muted": "#55556b",
      "border": "#000000",
      "rail": "#0b0b12",
      "rail-ink": "#ecebe3",
      "sig-work": "#0891b2",
      "sig-accent": "#e60076",
      "sig-done": "#0d9488",
      "sig-wait": "#d97706",
      "sig-err": "#e11d48",
      "sig-idle": "#7e7e94",
      "on-sig": "#0b0b12",
      "on-err": "#ffffff",
      "on-accent": "#ffffff",
      "on-idle": "#0b0b12",
      "shadow-col": "#000000",
      "mass": "#0b0b12",
      "stage": "#00a344",
      "stage-ink": "#04140a",
      "drip": "#0a7f5c",
      "halftone": "radial-gradient(circle at center, rgba(0,0,0,.075) 1.1px, transparent 1.4px)"
    },
    "extreme": {
      "$label": "Extreme \u00b7 intensity dial to 11",
      "$chassisOverride": {
        "brd": "3px",
        "brd-heavy": "4px",
        "brd-brush": "6px",
        "shadow-off": "6px",
        "shadow-off-lg": "9px"
      },
      "ground": "#0c0510",
      "board": "#12061a",
      "panel": "#18091f",
      "panel-2": "#210c2b",
      "ink": "#fdf0ff",
      "muted": "#c79ad6",
      "border": "#000000",
      "rail": "#ff2e97",
      "rail-ink": "#0c0510",
      "sig-work": "#00f0ff",
      "sig-accent": "#ff2e97",
      "sig-done": "#c6ff00",
      "sig-wait": "#ffd400",
      "sig-err": "#ff4d6d",
      "sig-idle": "#9a7aab",
      "on-sig": "#0c0510",
      "on-err": "#0c0510",
      "on-accent": "#0c0510",
      "on-idle": "#0c0510",
      "extra-purple": "#a855f7",
      "extra-orange": "#ff6b35",
      "shadow-col": "#000000",
      "mass": "#000000",
      "stage": "#c6ff00",
      "stage-ink": "#12061a",
      "drip": "#00f0ff",
      "halftone": "radial-gradient(circle at center, rgba(255,255,255,.07) 1.2px, transparent 1.5px)"
    },
    "phosphor": {
      "$label": "Phosphor \u00b7 single-channel green CRT",
      "ground": "#020a04",
      "board": "#041207",
      "panel": "#06180a",
      "panel-2": "#0a2210",
      "ink": "#43ff7a",
      "muted": "#2fac55",
      "border": "#031a08",
      "rail": "#020a04",
      "rail-ink": "#43ff7a",
      "sig-work": "#43ff7a",
      "sig-accent": "#b6ff00",
      "sig-done": "#00e05a",
      "sig-wait": "#a8ff3e",
      "sig-err": "#eaff40",
      "sig-idle": "#12602c",
      "on-sig": "#020a04",
      "on-err": "#020a04",
      "on-accent": "#020a04",
      "on-idle": "#ffffff",
      "shadow-col": "#031a08",
      "mass": "#010603",
      "stage": "#0d7a34",
      "stage-ink": "#d9ffe6",
      "drip": "#43ff7a",
      "halftone": "radial-gradient(circle at center, rgba(67,255,122,.09) 1.1px, transparent 1.4px)"
    }
  }
}
