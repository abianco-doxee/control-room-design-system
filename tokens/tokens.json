{
  "$schema": "https://schemas.control-room.dev/design-tokens/v1",
  "$description": "Control Room design tokens. Machine-readable source of truth for the token layer. Generated artifacts (dist/, design-tokens/) are built from this via npm run build:tokens.",
  "meta": {
    "name": "Control Room",
    "version": "1.0.0",
    "defaultTheme": "dark",
    "themes": [
      "dark",
      "light",
      "extreme",
      "phosphor"
    ],
    "selector": "html[data-theme]"
  },
  "primitive": {
    "$comment": "Global/primitive tier — context-free scales. Semantic + component tokens reference these; component CSS MUST use these, never raw px. Spacing is a 4px base (step n = 4n), matching Tailwind.",
    "space": {
      "0": {
        "value": "0",
        "cssVar": "--space-0"
      },
      "1": {
        "value": "4px",
        "cssVar": "--space-1"
      },
      "2": {
        "value": "8px",
        "cssVar": "--space-2"
      },
      "3": {
        "value": "12px",
        "cssVar": "--space-3"
      },
      "4": {
        "value": "16px",
        "cssVar": "--space-4"
      },
      "5": {
        "value": "20px",
        "cssVar": "--space-5"
      },
      "6": {
        "value": "24px",
        "cssVar": "--space-6"
      },
      "8": {
        "value": "32px",
        "cssVar": "--space-8"
      },
      "10": {
        "value": "40px",
        "cssVar": "--space-10"
      },
      "12": {
        "value": "48px",
        "cssVar": "--space-12"
      },
      "16": {
        "value": "64px",
        "cssVar": "--space-16"
      },
      "px": {
        "value": "1px",
        "cssVar": "--space-px"
      },
      "0-5": {
        "value": "2px",
        "cssVar": "--space-0-5"
      }
    },
    "text": {
      "2xs": {
        "value": "10px",
        "cssVar": "--text-2xs"
      },
      "xs": {
        "value": "11px",
        "cssVar": "--text-xs"
      },
      "sm": {
        "value": "12px",
        "cssVar": "--text-sm"
      },
      "base": {
        "value": "13px",
        "cssVar": "--text-base"
      },
      "md": {
        "value": "15px",
        "cssVar": "--text-md"
      },
      "lg": {
        "value": "19px",
        "cssVar": "--text-lg"
      },
      "xl": {
        "value": "clamp(28px, 5.5vw, 52px)",
        "cssVar": "--text-xl",
        "use": "display / single big number"
      }
    },
    "leading": {
      "tight": {
        "value": "1.05",
        "cssVar": "--leading-tight"
      },
      "normal": {
        "value": "1.6",
        "cssVar": "--leading-normal"
      },
      "display": {
        "value": "0.9",
        "cssVar": "--leading-display"
      }
    },
    "radius": {
      "none": {
        "value": "0px",
        "cssVar": "--radius-none",
        "use": "always 0 — system law"
      }
    },
    "z": {
      "base": {
        "value": "0",
        "cssVar": "--z-base"
      },
      "raised": {
        "value": "10",
        "cssVar": "--z-raised"
      },
      "sticky": {
        "value": "50",
        "cssVar": "--z-sticky"
      },
      "overlay": {
        "value": "100",
        "cssVar": "--z-overlay"
      },
      "modal": {
        "value": "1000",
        "cssVar": "--z-modal"
      }
    }
  },
  "chassis": {
    "$comment": "Theme-independent structural tokens. Overridden ONLY by the extreme theme.",
    "border": {
      "hair": {
        "value": "1.5px",
        "cssVar": "--brd-hair",
        "use": "hairline — dot/tag outlines, row separators, dense chrome (thinner than --brd)"
      },
      "thin": {
        "value": "2px",
        "cssVar": "--brd",
        "use": "internal dividers, minor panels"
      },
      "heavy": {
        "value": "3px",
        "cssVar": "--brd-heavy",
        "use": "major panels, mastheads, primary buttons"
      },
      "brush": {
        "value": "5px",
        "cssVar": "--brd-brush",
        "use": "outer chassis, bezels"
      }
    },
    "shadow": {
      "offsetSm": {
        "value": "2px",
        "cssVar": "--shadow-off-sm",
        "use": "small floating pieces — menus, chips, popovers"
      },
      "offset": {
        "value": "4px",
        "cssVar": "--shadow-off",
        "use": "standard hard drop offset"
      },
      "offsetLg": {
        "value": "6px",
        "cssVar": "--shadow-off-lg",
        "use": "mastheads, live instruments"
      },
      "$rule": "Hard offset only. blur-radius and spread are always 0. There is no soft shadow token."
    },
    "interaction": {
      "$comment": "Theme-independent interaction constants — how hover/disabled read, not a colour.",
      "disabledOpacity": {
        "value": "0.45",
        "cssVar": "--state-disabled-op",
        "use": "opacity for a disabled control"
      },
      "hoverMix": {
        "value": "12%",
        "cssVar": "--state-hover-mix",
        "use": "amount of --ink mixed into a surface on hover (color-mix)"
      },
      "rowH": {
        "value": "34px",
        "cssVar": "--row-h",
        "use": "default dense-table row height (density baseline)"
      },
      "focusWidth": {
        "value": "3px",
        "cssVar": "--focus-w",
        "use": "keyboard focus-ring thickness (colour is --sig-work, themed)"
      },
      "focusOffset": {
        "value": "2px",
        "cssVar": "--focus-offset",
        "use": "keyboard focus-ring offset from the control edge"
      },
      "motionIntensity": {
        "value": "1",
        "cssVar": "--motion-intensity",
        "use": "loudness dial (0..1) for non-essential animation; the `calm` ops profile sets 0"
      },
      "decorationIntensity": {
        "value": "1",
        "cssVar": "--decoration-intensity",
        "use": "loudness dial (0..1) for decorative texture layers; the `calm` ops profile tones it down"
      }
    },
    "radius": {
      "value": "0px",
      "cssVar": "--radius",
      "$rule": "Always 0. This token exists so the 0 is explicit and greppable."
    },
    "halftoneSize": {
      "value": "7px",
      "cssVar": "--halftone-size"
    },
    "breach": {
      "$comment": "Law 9 — the sanctioned rule-break. The ONLY place radius, blur, gradient and soft glow are licensed. One breach per screen.",
      "radius": {
        "value": "14px",
        "cssVar": "--breach-radius",
        "use": "the one soft corner"
      },
      "blur": {
        "value": "26px",
        "cssVar": "--breach-blur",
        "use": "blurred-blob softness"
      },
      "glow": {
        "value": "40px",
        "cssVar": "--breach-glow-size",
        "use": "soft glow radius"
      }
    },
    "pad": {
      "base": {
        "value": "var(--space-3)",
        "cssVar": "--pad"
      },
      "tight": {
        "value": "var(--space-2)",
        "cssVar": "--pad-tight"
      },
      "loose": {
        "value": "var(--space-4)",
        "cssVar": "--pad-loose"
      },
      "gap": {
        "value": "var(--space-3)",
        "cssVar": "--gap"
      },
      "gapTight": {
        "value": "var(--space-2)",
        "cssVar": "--gap-tight"
      }
    },
    "control": {
      "hSm": {
        "value": "28px",
        "cssVar": "--control-h-sm"
      },
      "hMd": {
        "value": "34px",
        "cssVar": "--control-h-md"
      },
      "hLg": {
        "value": "42px",
        "cssVar": "--control-h-lg"
      }
    },
    "bp": {
      "$comment": "Panel container-query breakpoints. @container conditions cannot read var(), so these are the canonical values to hardcode in @container rules.",
      "panelSm": {
        "value": "22rem",
        "cssVar": "--bp-panel-sm"
      },
      "panelMd": {
        "value": "34rem",
        "cssVar": "--bp-panel-md"
      },
      "panelLg": {
        "value": "52rem",
        "cssVar": "--bp-panel-lg"
      }
    }
  },
  "typography": {
    "$comment": "Two registers only — display and data. Nothing between (Law 5).",
    "family": {
      "sans": {
        "value": "\"CR Sans\", \"Archivo\", \"Arial Black\", \"Helvetica Neue\", system-ui, sans-serif",
        "cssVar": "--font-sans"
      },
      "display": {
        "value": "\"CR Display\", \"Saira Condensed\", \"Archivo Narrow\", \"Oswald\", var(--font-sans)",
        "cssVar": "--font-display"
      },
      "mono": {
        "value": "\"CR Mono\", \"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
        "cssVar": "--font-mono"
      }
    },
    "display": {
      "weight": {
        "value": 900,
        "cssVar": "--type-display-weight"
      },
      "tracking": {
        "value": "-0.038em",
        "cssVar": "--type-display-tracking"
      },
      "leading": {
        "value": 0.9,
        "cssVar": "--type-display-leading",
        "range": "0.88–0.92"
      },
      "transform": {
        "value": "uppercase",
        "cssVar": "--type-display-transform"
      },
      "sizeFluid": {
        "value": "clamp(28px, 5.5vw, 52px)",
        "use": "masthead / single big number"
      },
      "size": {
        "value": "clamp(2.5rem, 5.5vw, 4.5rem)",
        "cssVar": "--type-display-size"
      }
    },
    "data": {
      "size": {
        "value": "13px",
        "cssVar": "--type-data-size",
        "range": "12–13px"
      },
      "sizeSm": {
        "value": "11px",
        "cssVar": "--type-data-size-sm",
        "use": "labels, chrome"
      },
      "labelTracking": {
        "value": "0.07em",
        "cssVar": "--type-label-tracking"
      },
      "labelTransform": {
        "value": "uppercase",
        "cssVar": "--type-label-transform"
      },
      "sizeFluid": {
        "value": "clamp(12px, 1.45cqi, 14px)",
        "cssVar": "--type-data-size-fluid"
      },
      "weight": {
        "value": 500,
        "cssVar": "--type-data-weight"
      },
      "leading": {
        "value": 1.4,
        "cssVar": "--type-data-leading"
      },
      "tracking": {
        "value": "0",
        "cssVar": "--type-data-tracking"
      },
      "labelSize": {
        "value": "clamp(11px, 1.3cqi, 12px)",
        "cssVar": "--type-label-size"
      },
      "labelWeight": {
        "value": 800,
        "cssVar": "--type-label-weight"
      },
      "labelLeading": {
        "value": 1.2,
        "cssVar": "--type-label-leading"
      }
    },
    "$forbidden": "No sans body text at 18–24px. That mid-register makes tools read as generic admin templates.",
    "h1": {
      "size": {
        "value": "clamp(1.5rem, 3.2vw, 2.25rem)",
        "cssVar": "--type-h1-size"
      },
      "weight": {
        "value": 900,
        "cssVar": "--type-h1-weight"
      },
      "leading": {
        "value": 0.95,
        "cssVar": "--type-h1-leading"
      },
      "tracking": {
        "value": "-0.03em",
        "cssVar": "--type-h1-tracking"
      }
    },
    "h2": {
      "size": {
        "value": "clamp(1.15rem, 1.8vw, 1.5rem)",
        "cssVar": "--type-h2-size"
      },
      "weight": {
        "value": 800,
        "cssVar": "--type-h2-weight"
      },
      "leading": {
        "value": 1.05,
        "cssVar": "--type-h2-leading"
      },
      "tracking": {
        "value": "-0.02em",
        "cssVar": "--type-h2-tracking"
      }
    },
    "body": {
      "size": {
        "value": "clamp(13px, 1.6cqi, 15px)",
        "cssVar": "--type-body-size"
      },
      "weight": {
        "value": 400,
        "cssVar": "--type-body-weight"
      },
      "leading": {
        "value": 1.5,
        "cssVar": "--type-body-leading"
      },
      "tracking": {
        "value": "0",
        "cssVar": "--type-body-tracking"
      }
    },
    "meta": {
      "size": {
        "value": "clamp(10px, 1.2cqi, 11px)",
        "cssVar": "--type-meta-size"
      },
      "weight": {
        "value": 700,
        "cssVar": "--type-meta-weight"
      },
      "leading": {
        "value": 1.3,
        "cssVar": "--type-meta-leading"
      },
      "tracking": {
        "value": "0.04em",
        "cssVar": "--type-meta-tracking"
      }
    },
    "chrome": {
      "size": {
        "value": "10px",
        "cssVar": "--type-chrome-size"
      },
      "weight": {
        "value": 800,
        "cssVar": "--type-chrome-weight"
      },
      "leading": {
        "value": 1,
        "cssVar": "--type-chrome-leading"
      },
      "tracking": {
        "value": "0.1em",
        "cssVar": "--type-chrome-tracking"
      }
    }
  },
  "motion": {
    "durPress": {
      "value": "120ms",
      "cssVar": "--dur-press",
      "tier": 0
    },
    "durFast": {
      "value": "160ms",
      "cssVar": "--dur-fast",
      "use": "hover / interaction transitions"
    },
    "durMed": {
      "value": "260ms",
      "cssVar": "--dur-med",
      "use": "reveals, keyed moves"
    },
    "durAmbient": {
      "value": "3200ms",
      "cssVar": "--dur-ambient",
      "use": "idle attention / filler loops"
    },
    "easeSnap": {
      "value": "cubic-bezier(0.2, 0, 0, 1)",
      "cssVar": "--ease-snap",
      "use": "hard, decisive — the house feel (no soft overshoot/bounce)"
    },
    "easeStep": {
      "value": "steps(3, jump-none)",
      "cssVar": "--ease-step",
      "use": "stepped / digital motion (glitch, tickers)"
    },
    "tickAmbient": {
      "value": "180ms",
      "cssVar": "--tick-ambient",
      "tier": 1,
      "fps": "~5.5"
    }
  },
  "semantic": {
    "$comment": "Every semantic role maps to one cssVar. The value differs per theme; the meaning never does.",
    "surface": {
      "ground": {
        "cssVar": "--ground",
        "role": "page background, furthest back"
      },
      "board": {
        "cssVar": "--board",
        "role": "instrument / work surface"
      },
      "panel": {
        "cssVar": "--panel",
        "role": "raised card / panel"
      },
      "panel2": {
        "cssVar": "--panel-2",
        "role": "recessed / inset region"
      },
      "rail": {
        "cssVar": "--rail",
        "role": "navigation rail background"
      }
    },
    "text": {
      "ink": {
        "cssVar": "--ink",
        "role": "primary text"
      },
      "muted": {
        "cssVar": "--muted",
        "role": "secondary / label text"
      },
      "railInk": {
        "cssVar": "--rail-ink",
        "role": "text on the rail"
      },
      "onSig": {
        "cssVar": "--on-sig",
        "role": "text/icon placed on a signal fill"
      },
      "onErr": {
        "cssVar": "--on-err",
        "role": "text/icon on an error (--sig-err) fill; white in light, dark elsewhere"
      },
      "onAccent": {
        "cssVar": "--on-accent",
        "role": "text/icon on an accent (--sig-accent) fill"
      },
      "onAccent2": {
        "cssVar": "--on-accent-2",
        "role": "text on the second accent"
      },
      "onIdle": {
        "cssVar": "--on-idle",
        "role": "text/icon on an idle (--sig-idle) fill"
      }
    },
    "line": {
      "border": {
        "cssVar": "--border",
        "role": "contour / outline (near-black)"
      },
      "mass": {
        "cssVar": "--mass",
        "role": "black as a large fill area (Law 1)"
      },
      "shadowCol": {
        "cssVar": "--shadow-col",
        "role": "hard offset shadow color"
      }
    },
    "signal": {
      "$comment": "The state ramp. Each hue is bound to a machine state (Law 2). Color IS the state channel. accent2 is a second action key generated in OKLCH (build/build-palette.mjs).",
      "work": {
        "cssVar": "--sig-work",
        "state": "working",
        "note": "also the default focus outline"
      },
      "wait": {
        "cssVar": "--sig-wait",
        "state": "waiting / needs input"
      },
      "done": {
        "cssVar": "--sig-done",
        "state": "done / merged"
      },
      "err": {
        "cssVar": "--sig-err",
        "state": "error / failing"
      },
      "idle": {
        "cssVar": "--sig-idle",
        "state": "idle"
      },
      "accent": {
        "cssVar": "--sig-accent",
        "state": "attention / primary action"
      },
      "accent2": {
        "cssVar": "--sig-accent-2",
        "state": "secondary action / secondary key (not a machine state)"
      }
    },
    "keyed": {
      "stage": {
        "cssVar": "--stage",
        "role": "calm/nominal keyed stage flood (Law 2)"
      },
      "stageInk": {
        "cssVar": "--stage-ink",
        "role": "text on the stage flood"
      },
      "drip": {
        "cssVar": "--drip",
        "role": "house glitch / decay hue (Law 3)"
      }
    },
    "texture": {
      "halftone": {
        "cssVar": "--halftone",
        "role": "hardware texture; legal inside a bezel only (Law 6)"
      },
      "dither": {
        "cssVar": "--dither",
        "role": "ordered 1-bit dither (hardware only, Law 6/3)"
      },
      "scanline": {
        "cssVar": "--scanline",
        "role": "CRT scanlines (hardware only)"
      },
      "crosshatch": {
        "cssVar": "--crosshatch",
        "role": "±45° cross-hatch (hardware only, Law 4/6)"
      },
      "field": {
        "cssVar": "--field",
        "role": "whisper block-shade drafting field for dead background space"
      }
    }
  },
  "component": {
    "$comment": "Component tier — per-component tokens referencing semantic/primitive. Override these to restyle a component without touching its CSS. Theme-independent (values are var() refs that resolve per theme).",
    "button": {
      "padX": {
        "value": "var(--space-4)",
        "cssVar": "--cr-btn-pad-x"
      },
      "padY": {
        "value": "var(--space-2)",
        "cssVar": "--cr-btn-pad-y"
      },
      "gap": {
        "value": "var(--space-2)",
        "cssVar": "--cr-btn-gap"
      },
      "bg": {
        "value": "var(--sig-wait)",
        "cssVar": "--cr-btn-bg"
      },
      "fg": {
        "value": "var(--on-sig)",
        "cssVar": "--cr-btn-fg"
      },
      "size": {
        "value": "var(--text-sm)",
        "cssVar": "--cr-btn-size"
      }
    },
    "panel": {
      "pad": {
        "value": "var(--space-3)",
        "cssVar": "--cr-panel-pad"
      },
      "bg": {
        "value": "var(--panel)",
        "cssVar": "--cr-panel-bg"
      },
      "gap": {
        "value": "var(--space-3)",
        "cssVar": "--cr-panel-gap"
      }
    },
    "chip": {
      "padX": {
        "value": "var(--space-2)",
        "cssVar": "--cr-chip-pad-x"
      },
      "padY": {
        "value": "var(--space-0-5)",
        "cssVar": "--cr-chip-pad-y"
      },
      "bg": {
        "value": "var(--sig-done)",
        "cssVar": "--cr-chip-bg"
      },
      "fg": {
        "value": "var(--on-sig)",
        "cssVar": "--cr-chip-fg"
      }
    },
    "row": {
      "padY": {
        "value": "var(--space-2)",
        "cssVar": "--cr-row-pad-y"
      },
      "gap": {
        "value": "var(--space-3)",
        "cssVar": "--cr-row-gap"
      }
    },
    "hero": {
      "pad": {
        "value": "var(--space-4)",
        "cssVar": "--cr-hero-pad"
      },
      "gap": {
        "value": "var(--space-4)",
        "cssVar": "--cr-hero-gap"
      },
      "bg": {
        "value": "var(--sig-accent)",
        "cssVar": "--cr-hero-bg"
      },
      "fg": {
        "value": "var(--on-accent)",
        "cssVar": "--cr-hero-fg"
      }
    },
    "nav": {
      "width": {
        "value": "180px",
        "cssVar": "--cr-nav-w"
      },
      "bg": {
        "value": "var(--rail)",
        "cssVar": "--cr-nav-bg"
      },
      "fg": {
        "value": "var(--rail-ink)",
        "cssVar": "--cr-nav-fg"
      },
      "border": {
        "value": "var(--border)",
        "cssVar": "--cr-nav-border"
      },
      "activeBg": {
        "value": "var(--sig-accent)",
        "cssVar": "--cr-nav-active-bg"
      },
      "activeFg": {
        "value": "var(--on-accent)",
        "cssVar": "--cr-nav-active-fg"
      }
    },
    "tabs": {
      "$comment": "Tabs. dt on the tablist retargets any of these per instance (e.g. dt={{ '--cr-tabs-indicator': '#f0f' }}) without touching global --sig-work.",
      "border": {
        "value": "var(--border)",
        "cssVar": "--cr-tabs-border"
      },
      "tabFg": {
        "value": "var(--muted)",
        "cssVar": "--cr-tabs-tab-fg"
      },
      "tabHoverFg": {
        "value": "var(--ink)",
        "cssVar": "--cr-tabs-tab-hover-fg"
      },
      "tabActiveFg": {
        "value": "var(--ink)",
        "cssVar": "--cr-tabs-tab-active-fg"
      },
      "indicator": {
        "value": "var(--sig-work)",
        "cssVar": "--cr-tabs-indicator"
      },
      "tabPadX": {
        "value": "var(--space-4)",
        "cssVar": "--cr-tabs-tab-pad-x"
      },
      "tabPadY": {
        "value": "var(--space-2)",
        "cssVar": "--cr-tabs-tab-pad-y"
      }
    },
    "menu": {
      "$comment": "Dropdown menu. Panel + item surfaces; item hover is a color-mix expression by default. Retarget per instance via dt on the menu root.",
      "panelBg": {
        "value": "var(--panel)",
        "cssVar": "--cr-menu-panel-bg"
      },
      "panelBorder": {
        "value": "var(--border)",
        "cssVar": "--cr-menu-panel-border"
      },
      "itemFg": {
        "value": "var(--ink)",
        "cssVar": "--cr-menu-item-fg"
      },
      "itemHoverBg": {
