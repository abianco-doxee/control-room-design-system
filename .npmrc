# Emulate npm's flat node_modules so the build's require.resolve() / bare-import
# assumptions (compile-mitosis, build-barrels, the MCP server, root tests) keep working.
node-linker=hoisted
# Run pre/post lifecycle scripts (pretest:pkg, prebuild:site, prepack, …).
enable-pre-post-scripts=true
link-workspace-packages=true
# Publish target for the @abianco-doxee scope: GitHub Packages. Workspace deps use
# `workspace:*`, so install always links locally and never fetches this scope from
# the registry — this mapping only takes effect at `changeset publish` time (CI
# injects the auth token via setup-node). GitHub Packages ties a scope to a GitHub
# org/user of the same name, and @abianco-doxee matches this repo's owner, so no org
# move is needed; see references/monorepo-migration.md ("Publishing").
@abianco-doxee:registry=https://npm.pkg.github.com
