{
  "name": "@control-room/design-system",
  "version": "1.0.0",
  "description": "Control Room — a neon-noir, neobrutalist design system for dense operational dashboards. Design language (the nine laws), a four-theme token layer, a component library, motion tiers, and an accessibility contract.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "files": [
    "dist",
    "catalog",
    "references",
    "templates",
    "checklists",
    "SKILL.md",
    "README.md",
    "packages",
    "lib"
  ],
  "exports": {
    "./tokens.json": "./packages/tokens/tokens/tokens.json",
    "./css": "./packages/tokens/dist/control-room.css",
    "./structure.css": "./packages/tokens/dist/structure.css",
    "./themes/*": "./packages/tokens/dist/themes/*",
    "./theme-contract": "./packages/tokens/dist/theme-contract.json",
    "./theme": "./packages/utils/theme/index.js",
    "./components": "./packages/styles/styles/components.css",
    "./base": "./packages/styles/styles/base.css",
    "./styles/*": "./packages/styles/styles/parts/*",
    "./tailwind.css": "./packages/styles/styles/tailwind.css",
    "./tw-theme.css": "./packages/tokens/dist/tw-theme.css",
    "./flat": "./packages/tokens/dist/tokens.flat.json",
    "./dtcg": "./packages/tokens/design-tokens/control-room.tokens.json",
    "./catalog": "./catalog/catalog.json",
    "./forms": "./packages/utils/forms/index.js",
    "./react": {
      "types": "./packages/components/dist/pkg/react/index.d.ts",
      "import": "./packages/components/dist/pkg/react/index.js",
      "default": "./packages/components/dist/pkg/react/index.js"
    },
    "./vue": {
      "types": "./packages/components/dist/frameworks/vue/index.d.ts",
      "vue": "./packages/components/dist/frameworks/vue/index.ts",
      "import": "./packages/components/dist/frameworks/vue/index.ts",
      "default": "./packages/components/dist/frameworks/vue/index.ts"
    },
    "./svelte": {
      "types": "./packages/components/dist/frameworks/svelte/index.d.ts",
      "svelte": "./packages/components/dist/frameworks/svelte/index.js",
      "import": "./packages/components/dist/frameworks/svelte/index.js",
      "default": "./packages/components/dist/frameworks/svelte/index.js"
    },
    "./angular": {
      "types": "./packages/components/dist/frameworks/angular/index.d.ts",
      "import": "./packages/components/dist/frameworks/angular/index.ts",
      "default": "./packages/components/dist/frameworks/angular/index.ts"
    },
    "./solid": {
      "types": "./packages/components/dist/frameworks/solid/index.d.ts",
      "solid": "./packages/components/dist/frameworks/solid/index.jsx",
      "import": "./packages/components/dist/frameworks/solid/index.jsx",
      "default": "./packages/components/dist/frameworks/solid/index.jsx"
    },
    "./qwik": {
      "types": "./packages/components/dist/pkg/qwik/index.d.ts",
      "import": "./packages/components/dist/pkg/qwik/index.js",
      "default": "./packages/components/dist/pkg/qwik/index.js"
    },
    "./frameworks/*": "./packages/components/dist/frameworks/*",
    "./cn": {
      "types": "./packages/utils/cn.d.ts",
      "default": "./packages/utils/cn.js"
    },
    "./href": {
      "types": "./packages/utils/href.d.ts",
      "default": "./packages/utils/href.js"
    },
    "./duration": {
      "types": "./packages/utils/duration.d.ts",
      "default": "./packages/utils/duration.js"
    },
    "./position": "./packages/utils/position.js",
    "./time-scale": "./packages/utils/time-scale.js",
    "./icons/pixel": "./packages/icons/pixel.ts"
  },
  "scripts": {
    "build:tokens": "node packages/tokens/build/build-tokens.mjs",
    "build:theme": "node packages/tokens/build/build-theme.mjs",
    "build:palette": "node packages/tokens/build/build-palette.mjs",
    "build:tw": "tailwindcss -i build/tailwind-input.css -o dist/utilities.css",
    "build:styles": "node packages/styles/build/build-styles.mjs",
    "build:icons": "node packages/icons/build/build-icons.mjs",
    "build:components": "node packages/components/build/compile-mitosis.mjs && node packages/components/build/build-fix-qwik.mjs && node packages/components/build/build-fix-react.mjs && node packages/components/build/build-fix-angular.mjs && node packages/components/build/build-barrels.mjs && node packages/components/build/build-pkg-types.mjs",
    "build:components:cli": "npm run build:cli -w @control-room/components",
    "build:pkg": "node packages/components/build/build-pkg.mjs",
    "build:catalog": "node build/build-catalog.mjs",
    "build:gallery": "node build/build-gallery.mjs",
    "build:showcase": "node build/build-showcase.mjs",
    "build:brand-preview": "node build/build-brand-preview.mjs",
    "build:content": "node build/build-docs-content.mjs",
    "prebuild:site": "npm run build:content",
    "build:site": "astro build",
    "build": "npm run build:tokens && npm run build:theme && npm run build:brand-preview && npm run build:tw && npm run build:styles && npm run build:icons && npm run build:catalog && npm run build:gallery && npm run build:components && npm run build:pkg && npm run build:showcase && npm run build:content && astro build",
    "prepack": "npm run build:components && npm run build:pkg",
    "dev": "npm run build:content && astro dev",
    "preview": "astro preview",
    "verify:tokens": "node packages/tokens/build/build-tokens.mjs --check",
    "verify:theme": "node packages/tokens/build/build-theme.mjs --check",
    "verify:pkg": "node packages/components/build/build-pkg.mjs --check",
    "verify:catalog": "node build/build-catalog.mjs --check",
    "verify:types": "tsc -p packages/components/build/tsconfig.frameworks.json",
    "verify:pkg-types": "node packages/components/build/build-pkg-types.mjs --check",
    "verify:palette": "node packages/tokens/build/build-palette.mjs --check",
    "verify:styles": "node packages/styles/build/build-styles.mjs --check",
    "verify:icons": "node packages/icons/build/build-icons.mjs --check",
    "skills:sync": "node scripts/skills-sync.mjs",
    "skills:check": "node scripts/skills-sync.mjs --check",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "pretest:e2e": "npm run build:tokens && npm run build:theme && npm run build:brand-preview && npm run build:components && npm run build:gallery && npm run build:showcase",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.mjs tests/a11y-showcase.spec.mjs",
    "test:islands": "playwright test tests/showcase-islands.spec.mjs",
    "test:responsive": "playwright test tests/responsive.spec.mjs",
    "test:visual": "playwright test tests/visual.spec.mjs",
    "test:visual:update": "playwright test tests/visual.spec.mjs --update-snapshots",
    "test:forms": "node --test tests/forms.test.mjs",
    "test:theme": "node --test packages/tokens/tests/theme.test.mjs",
    "test:position": "node --test tests/position.test.mjs",
    "test:timescale": "node --test tests/time-scale.test.mjs",
    "test:separation": "node --test tests/appearance-separation.test.mjs",
    "test:rtl": "node --test tests/rtl.test.mjs",
    "pretest:pkg": "npm run build:pkg",
    "test:pkg": "node --test tests/pkg-react.test.mjs tests/pkg-qwik.test.mjs tests/pkg-vue.test.mjs tests/pkg-exports.test.mjs",
    "pretest:frameworks": "npm run build:components",
    "test:frameworks": "node --test tests/pkg-frameworks.test.mjs tests/cross-fw-contract.test.mjs",
    "test:contract": "node --test tests/styling-contract.test.mjs tests/responsive.test.mjs tests/utils-ports.test.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "verify": "npm run verify:tokens && npm run verify:theme && npm run verify:palette && npm run verify:styles && npm run verify:icons && npm run verify:catalog && npm run skills:check"
  },
  "devDependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-server": "^21.2.19",
    "@astrojs/starlight": "^0.41.7",
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.7",
    "@builder.io/mitosis": "^0.14.0",
    "@builder.io/mitosis-cli": "^0.14.0",
    "@builder.io/qwik": "^1.20.0",
    "@changesets/cli": "^2.31.1",
    "@fontsource/saira-condensed": "^5.3.0",
    "@iconify-json/pixelarticons": "^1.2.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/server-renderer": "^3.5.41",
    "astro": "^7.2.0",
    "babel-preset-solid": "^1.9.12",
    "culori": "^4.0.2",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.14",
    "svelte": "^4.2.20",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "undici": "^8.10.0",
    "vue": "^3.5.41",
    "zone.js": "^0.16.2"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@builder.io/qwik": ">=1.5",
    "react": ">=18",
    "react-dom": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@builder.io/qwik": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@control-room/components": "1.0.0",
    "@control-room/icons": "1.0.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "arktype": "^2.2.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
