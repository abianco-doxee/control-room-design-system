{
  "name": "@control-room/design-system",
  "version": "1.0.0",
  "description": "Control Room — a neon-noir, neobrutalist design system for dense operational dashboards. Design language (the seven laws), a four-theme token layer, a component library, motion tiers, and an accessibility contract.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "files": [
    "tokens",
    "dist",
    "references",
    "templates",
    "checklists",
    "SKILL.md",
    "README.md"
  ],
  "exports": {
    "./tokens.json": "./tokens/tokens.json",
    "./css": "./dist/control-room.css",
    "./tailwind": "./dist/tailwind-preset.cjs",
    "./flat": "./dist/tokens.flat.json",
    "./dtcg": "./design-tokens/control-room.tokens.json"
  },
  "scripts": {
    "build:tokens": "node build/build-tokens.mjs",
    "build:catalog": "node build/build-catalog.mjs",
    "build:gallery": "node build/build-gallery.mjs",
    "build:content": "node build/build-docs-content.mjs",
    "prebuild:site": "npm run build:content",
    "build:site": "astro build",
    "build": "npm run build:tokens && npm run build:catalog && npm run build:gallery && npm run build:content && astro build",
    "dev": "npm run build:content && astro dev",
    "preview": "astro preview",
    "verify:tokens": "node build/build-tokens.mjs --check",
    "verify:catalog": "node build/build-catalog.mjs --check",
    "skills:sync": "node scripts/skills-sync.mjs",
    "skills:check": "node scripts/skills-sync.mjs --check",
    "figma:pull": "node scripts/figma-pull.mjs",
    "verify": "npm run verify:tokens && npm run verify:catalog && npm run skills:check"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.6",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.6"
  }
}
