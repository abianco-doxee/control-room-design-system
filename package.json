{
  "name": "@control-room/design-system",
  "version": "1.0.0",
  "description": "Control Room — a neon-noir, neobrutalist design system for dense operational dashboards. Design language (the nine laws), a four-theme token layer, a component library, motion tiers, and an accessibility contract.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "files": [
    "tokens",
    "dist",
    "styles",
    "design-tokens",
    "catalog",
    "references",
    "templates",
    "checklists",
    "SKILL.md",
    "README.md",
    "utils",
    "lib"
  ],
  "exports": {
    "./tokens.json": "./tokens/tokens.json",
    "./css": "./dist/control-room.css",
    "./components": "./styles/components.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./tw-theme.css": "./dist/tw-theme.css",
    "./flat": "./dist/tokens.flat.json",
    "./dtcg": "./design-tokens/control-room.tokens.json",
    "./catalog": "./catalog/catalog.json",
    "./forms": "./lib/forms/index.js",
    "./react": "./dist/frameworks/react/index.ts",
    "./vue": "./dist/frameworks/vue/index.ts",
    "./svelte": "./dist/frameworks/svelte/index.js",
    "./angular": "./dist/frameworks/angular/index.ts",
    "./solid": "./dist/frameworks/solid/index.jsx",
    "./qwik": "./dist/frameworks/qwik/index.ts",
    "./frameworks/*": "./dist/frameworks/*",
    "./cn": {
      "types": "./utils/cn.d.ts",
      "default": "./utils/cn.js"
    }
  },
  "scripts": {
    "build:tokens": "node build/build-tokens.mjs",
    "build:palette": "node build/build-palette.mjs",
    "build:tw": "tailwindcss -i build/tailwind-input.css -o dist/utilities.css",
    "build:components": "mitosis build && node build/build-fix-qwik.mjs && node build/build-fix-react.mjs && node build/build-barrels.mjs",
    "build:catalog": "node build/build-catalog.mjs",
    "build:gallery": "node build/build-gallery.mjs",
    "build:showcase": "node build/build-showcase.mjs",
    "build:content": "node build/build-docs-content.mjs",
    "prebuild:site": "npm run build:content",
    "build:site": "astro build",
    "build": "npm run build:tokens && npm run build:tw && npm run build:catalog && npm run build:gallery && npm run build:components && npm run build:showcase && npm run build:content && astro build",
    "dev": "npm run build:content && astro dev",
    "preview": "astro preview",
    "verify:tokens": "node build/build-tokens.mjs --check",
    "verify:catalog": "node build/build-catalog.mjs --check",
    "verify:types": "tsc -p build/tsconfig.frameworks.json",
    "verify:palette": "node build/build-palette.mjs --check",
    "skills:sync": "node scripts/skills-sync.mjs",
    "skills:check": "node scripts/skills-sync.mjs --check",
    "pretest:e2e": "npm run build:tokens && npm run build:components && npm run build:gallery && npm run build:showcase",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.mjs tests/a11y-showcase.spec.mjs",
    "test:islands": "playwright test tests/showcase-islands.spec.mjs",
    "test:responsive": "playwright test tests/responsive.spec.mjs",
    "test:visual": "playwright test tests/visual.spec.mjs",
    "test:visual:update": "playwright test tests/visual.spec.mjs --update-snapshots",
    "test:forms": "node --test tests/forms.test.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "verify": "npm run verify:tokens && npm run verify:palette && npm run verify:catalog && npm run skills:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@builder.io/mitosis": "^0.14.0",
    "@builder.io/mitosis-cli": "^0.14.0",
    "@changesets/cli": "^2.31.1",
    "@fontsource/saira-condensed": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "culori": "^4.0.2",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "undici": "^8.10.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.6",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "arktype": "^2.2.3",
    "astro": "^7.1.6",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
